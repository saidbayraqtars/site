---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Fx from '../components/Fx.astro';

const {
  title = 'ArcTeknik — Teknik Servis & Restoran Otomasyon Yazılımı',
  description = 'ArcTeknik: teknik servis (kabul, kasa, WhatsApp CRM, garanti) ve ArcTeknik Şef restoran adisyon/POS sistemini tek çatıda sunan kurumsal işletme yazılımı.',
} = Astro.props;
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#06080f" />
  <title>{title}</title>
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/assets/icon.png" />
  <meta property="og:type" content="website" />
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Sora:wght@600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <Fx />
  <Nav />
  <main>
    <slot />
  </main>
  <Footer />

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script is:inline src="/site.js"></script>
</body>
</html>
