---
const path = (Astro.url.pathname.replace(/\/+$/, '') || '/');
const links = [
  { href: '/teknik-servis', label: 'Teknik Servis' },
  { href: '/sef', label: 'ArcTeknik Şef' },
  { href: '/ekranlar', label: 'Ekranlar' },
  { href: '/paketler', label: 'Paketler' },
  { href: '/sss', label: 'SSS' },
  { href: '/iletisim', label: 'İletişim' },
];
const isActive = (h) => path === h;
---
<header class="nav" id="nav">
  <div class="container nav__inner">
    <a href="/" class="brand" aria-label="ArcTeknik ana sayfa">
      <img class="brand__logo" src="/assets/logo.png" alt="ArcTeknik" width="40" height="40" />
      <span class="brand__text"><strong>ArcTeknik</strong><em>İşletme Otomasyonu</em></span>
    </a>

    <nav class="nav__links" id="navLinks">
      {links.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <div class="nav__cta">
        <a class="btn btn--ghost" href="https://lisans.arcteknik.com.tr" title="Lisans yönetim paneli (yakında)">Lisans Paneli<span class="badge-soon">yakında</span></a>
        <a class="btn btn--primary" href="/iletisim">Demo Talep</a>
      </div>
    </nav>

    <button class="nav__burger" id="burger" aria-label="Menü" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
